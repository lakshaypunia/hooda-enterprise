# WhatsApp number that receives buy requests and product queries.
# International format, digits only (country code + number, no "+" or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Optional separate number for product/technical queries. Falls back to the number above.
NEXT_PUBLIC_WHATSAPP_QUERY_NUMBER=

# Show the English/Hindi switch in the header (Hindi pages exist at /hi either way).
NEXT_PUBLIC_SHOW_HINDI=false

# Public site URL, used for SEO metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
