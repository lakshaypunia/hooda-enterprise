# All NEXT_PUBLIC_* values are baked in at build time — redeploy after changing them.

# Shop phone number (10 digits or with 91 prefix). Shown on the site and used for call links.
# Also used for WhatsApp unless NEXT_PUBLIC_WHATSAPP_NUMBER is set.
NEXT_PUBLIC_PHONE_NUMBER=8168200335

# Optional: WhatsApp number for orders, if different from the phone number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: separate WhatsApp number for product questions. Falls back to the order number.
NEXT_PUBLIC_WHATSAPP_QUERY_NUMBER=

# Districts we deliver to, comma-separated. Leave empty to hide all service-area text.
NEXT_PUBLIC_SERVICE_AREAS=Rohtak,Sonipat,Jhajjar
# Same list in Hindi, same order (used on /hi pages).
NEXT_PUBLIC_SERVICE_AREAS_HI=रोहतक,सोनीपत,झज्जर

# Public site URL for SEO (canonical links, sitemap, WhatsApp product links).
# On Vercel this can be left empty: the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Show the English/Hindi switch in the header (Hindi pages exist at /hi either way).
NEXT_PUBLIC_SHOW_HINDI=false
